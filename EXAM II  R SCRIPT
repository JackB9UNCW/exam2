## ---- LOGS (Table 2.3) ----
## log-level: %change in y = 100 * sum(b * dx). Works for one x or several.
pct_loglevel <- function(b, dx) 100 * sum(b * dx)
## log-log: %change in y = b * (%change in x). A FALL is a negative %.
pct_loglog <- function(b, pct_x) b * pct_x
## level-log: change in y (units) = (b / 100) * (%change in x)
units_levellog <- function(b, pct_x) (b / 100) * pct_x

## predict_y(): plug values into a fitted lm. If the model is log(y), returns y in levels via exp().
##   values: a named list, e.g. list(educ = 16, exper = 5, tenure = 1)
##   It handles log(x) terms in the formula by itself (you give the RAW value, e.g. income = 27071).
predict_y <- function(reg, values) {
  nd <- as.data.frame(values)
  fit <- predict(reg, newdata = nd)
  lhs <- deparse(formula(reg)[[2]])
  if (grepl("^log\\(", lhs)) {
    cat("  model is", lhs, "-> predicted log =", fit, "-> exp() =", exp(fit), "\n")
    return(unname(exp(fit)))
  }
  unname(fit)
}

## ---- VARIANCE AND STANDARD ERRORS ----
sst_from_x   <- function(x) sum((x - mean(x))^2)            # SST from the x values
sst_from_sd  <- function(n, s) (n - 1) * s^2                # SST from a standard deviation
sst_from_var <- function(n, v) (n - 1) * v                  # SST from a variance
sd_b1      <- function(sigma, SST_X) sigma / sqrt(SST_X)    # Theorem 2.2 (simple regression)
sigma2_hat <- function(SSR, n, K) SSR / (n - K - 1)         # K = number of x's (simple: K = 1). MUST give K.
sigma_hat  <- function(SSR, n, K) sqrt(SSR / (n - K - 1))   # "standard error of the regression" = sqrt
se_simple  <- function(SSR, n, SST_X) sqrt(SSR / (n - 2)) / sqrt(SST_X)
se_multi   <- function(sigmahat, SSTj, R2j) sigmahat / sqrt(SSTj * (1 - R2j))
se_scale   <- function(se, k) se / sqrt(k)                  # sample k times as large

## se_by_hand(): every piece of se(bj) from a fitted multiple regression, on the rows lm() USED.
##   reg: your lm;  xj: the variable name in quotes, exactly as in the formula,
##        e.g. "bdrms", or "log(libvol)" for a logged x
##   Prints df, sigma-hat, SST_j, R_j^2, the se, and summary()'s se so you can check they match.
se_by_hand <- function(reg, xj) {
  X <- model.matrix(reg)[, -1, drop = FALSE]                # x's on the rows lm() kept (drops NAs!)
  if (!(xj %in% colnames(X))) stop("xj must be one of: ", paste(colnames(X), collapse = ", "))
  others <- setdiff(colnames(X), xj)
  n <- nrow(X); K <- ncol(X); df <- n - K - 1
  SSR <- sum(reg$residuals^2)
  sh <- sqrt(SSR / df)
  xcol <- X[, xj]
  SSTj <- sum((xcol - mean(xcol))^2)
  if (length(others) > 0) {
    aux <- lm(xcol ~ X[, others])                             # xj on the OTHER x's
    R2j <- summary(aux)$r.squared
  } else R2j <- 0
  se <- sh / sqrt(SSTj * (1 - R2j))
  cat("  rows used n =", n, "| K =", K, "| df = n-K-1 =", df, "\n")
  cat("  SSR =", SSR, "| sigma-hat =", sh, "| sigma-hat^2 =", sh^2, "\n")
  cat("  SST_j =", SSTj, "| R_j^2 =", R2j, " (", xj, "on", paste(others, collapse = " + "), ")\n")
  cat("  se by hand =", se, "| summary() se =", summary(reg)$coefficients[xj, "Std. Error"], "\n")
  invisible(se)
}

## ---- MULTIPLE REGRESSION ----
## predict_lin(): b0 + b1*x1 + ... from numbers you are GIVEN (no data)
predict_lin <- function(b, x) b[1] + sum(b[-1] * x)
## change_lin(): change in y-hat = sum(b * dx). The intercept never matters for a change.
change_lin <- function(b_slopes, dx) sum(b_slopes * dx)

## ---- OMITTED-VARIABLE BIAS, formula (3.23):  b1_tilde = b1_hat + b2_hat * delta1_tilde ----
b1_multiple <- function(b1_tilde, b2_hat, delta1) b1_tilde - b2_hat * delta1
b1_simple   <- function(b1_hat, b2_hat, delta1)   b1_hat + b2_hat * delta1
## ovb_data(): all the pieces from real data. y, x1 = included, x2 = omitted (names in quotes).
ovb_data <- function(y, x1, x2, data) {
  d <- na.omit(data[, c(y, x1, x2)])                        # same rows for all three regressions
  long  <- lm(reformulate(c(x1, x2), response = y), data = d)
  short <- lm(reformulate(x1, response = y), data = d)
  aux   <- lm(reformulate(x1, response = x2), data = d)     # OMITTED on INCLUDED
  b1h <- coef(long)[[x1]]; b2h <- coef(long)[[x2]]; del <- coef(aux)[[x1]]; b1t <- coef(short)[[x1]]
  cat("  long  (", y, "~", x1, "+", x2, "): b1-hat =", b1h, " b2-hat =", b2h, "\n")
  cat("  aux   (", x2, "~", x1, "): delta1-tilde =", del, "\n")
  cat("  bias term b2-hat * delta1-tilde =", b2h * del, "\n")
  cat("  short (", y, "~", x1, "): b1-tilde =", b1t, " = b1-hat + bias =", b1h + b2h * del, "\n")
  invisible(c(b1_hat = b1h, b2_hat = b2h, delta1 = del, bias = b2h * del, b1_tilde = b1t))
}
## ovb_sign(): sign of beta2 (omitted var's effect on y) times sign of corr(omitted, included)
ovb_sign <- function(effect_on_y, corr_with_x) {
  s <- sign(effect_on_y) * sign(corr_with_x)
  if (s > 0) "biased UPWARD" else if (s < 0) "biased DOWNWARD" else "NO bias"
}

## ---- BEFORE EXAM I ----
sd_linear <- function(a, EX, EX2) abs(a) * sqrt(EX2 - EX^2)          # sd(aX + b); b drops out
var_combo <- function(a, c, VarX, VarY, CovXY) a^2 * VarX + c^2 * VarY + 2 * a * c * CovXY
joint_table <- function(xv, yv, p) {
  stopifnot(abs(sum(p) - 1) < 1e-8)                          # probabilities must sum to 1
  EX <- sum(p * xv); EY <- sum(p * yv)
  VarX <- sum(p * xv^2) - EX^2; VarY <- sum(p * yv^2) - EY^2
  Cov <- sum(p * xv * yv) - EX * EY
  out <- c(EX = EX, EY = EY, VarX = VarX, VarY = VarY, Cov = Cov,
           Cor = Cov / sqrt(VarX * VarY), slope_beta1 = Cov / VarX)
  print(out); invisible(out)
}
ols_hand <- function(x, y) {
  reg <- lm(y ~ x)
  cat("  b0 =", coef(reg)[[1]], " b1 =", coef(reg)[[2]], "\n  residuals:", reg$residuals, "\n")
  invisible(reg)
}

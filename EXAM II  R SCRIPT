## [B1] sd(b1-hat) = sigma / sqrt(SST_X)       (TRUE sigma given -> "sd";  sigma-hat -> "se")
##   SST_X from data:  sum((x - mean(x))^2)
##   SST_X from S_X (standard deviation):  (n - 1) * S_X^2     <- SQUARE the sd
##   SST_X from S_X^2 (variance):          (n - 1) * S_X^2
